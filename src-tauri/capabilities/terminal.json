{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "terminal",
  "description": "Console windows (terminal-<n>): their own session only, plus title and close of their own window (DECISIONS.md D-46).",
  "local": true,
  "windows": [
    "terminal-*"
  ],
  "permissions": [
    "core:window:allow-set-title",
    "core:window:allow-close",
    "allow-terminal-attach",
    "allow-terminal-input",
    "allow-terminal-resize"
  ]
}
