{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window only: app commands and the core APIs it uses. Editor windows get no capability (DECISIONS.md D-14).",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "allow-app-info",
    "allow-editor-status",
    "allow-editor-open",
    "allow-editor-restart",
    "allow-projects-list",
    "allow-terminal-open",
    "allow-components-list",
    "allow-setup-state",
    "allow-setup-start",
    "allow-setup-cancel",
    "allow-components-apply",
    "allow-agents-status",
    "allow-agent-launch",
    "allow-agent-sign-out",
    "allow-folder-open",
    "allow-project-create",
    "allow-project-delete",
    "allow-project-clone",
    "allow-project-site",
    "allow-run-list",
    "allow-run-start",
    "allow-run-stop",
    "allow-run-log",
    "allow-run-clear",
    "allow-run-ports",
    "allow-run-set-port",
    "allow-url-open",
    "allow-settings-get",
    "allow-settings-set",
    "allow-update-status",
    "allow-update-check",
    "allow-eject-list",
    "allow-eject-run",
    "allow-app-quit"
  ]
}
