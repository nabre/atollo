    { "from": "pnpm", "to": "node", "kind": "runs-on", "range": "^22.22.2 || ^24.15.0 || >=26", "note": "yarn passa da corepack, che vuole Node.js 22.22, 24.15 o 26 e successivi; pnpm è un programma a sé" },
