#!/bin/sh
# Atollo: agy for Git Bash, macOS and Linux, with its Google login carried
# into the system's keyring before the run and back into the kit after it
# (see agy.cmd). agy.exe only where it exists (Git Bash on Windows).
# The Gemini API key of the settings, for agy only: the kit's environment
# does not hold it.
key_file="$CP_DATA/app/secrets/gemini-api-key"
if [ -z "$GEMINI_API_KEY" ] && [ -f "$key_file" ]; then
    GEMINI_API_KEY=$(tr -d ' \t\r\n' < "$key_file")
    [ -n "$GEMINI_API_KEY" ] && export GEMINI_API_KEY
fi
"$ATOLLO_EXE" keyring restore
if [ -f "$CP_ANTIGRAVITY/agy.exe" ]; then
    "$CP_ANTIGRAVITY/agy.exe" "$@"
else
    "$CP_ANTIGRAVITY/agy" "$@"
fi
rc=$?
"$ATOLLO_EXE" keyring save
exit $rc
