#!/bin/sh
# Atollo: Claude Code with the token saved in the kit (macOS, "Collega con
# un token"), given to Claude Code only: the kit's environment does not
# hold it, so projects' scripts never see it. Without the token (Windows,
# Linux, not linked) Claude Code runs as it is. Written by Atollo; edits
# are replaced at the next start.
token_file="$CP_DATA/agents/claude/oauth-token"
if [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ] && [ -f "$token_file" ]; then
    token=$(tr -d ' \t\r\n' < "$token_file")
    case "$token" in
        sk-ant-oat*)
            CLAUDE_CODE_OAUTH_TOKEN="$token"
            export CLAUDE_CODE_OAUTH_TOKEN
            ;;
    esac
    unset token
fi
if [ -f "$CP_APPS/claude/claude.exe" ]; then
    exec "$CP_APPS/claude/claude.exe" "$@"
fi
exec "$CP_APPS/claude/claude" "$@"
