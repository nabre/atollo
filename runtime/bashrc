# Dev-Kit: Git Bash of the kit (written by Dev-Kit.exe to data\kit\bashrc).
# Started as: bash --rcfile <this file> -i. The PC's ~/.bashrc is not read:
# HOME is data\home, so a ~/.bashrc there (yours) is loaded at the end.
# Also read by the system bash of macOS (3.2) and Linux: no bash 4 syntax
# (${var,,}, declare -A, mapfile, ;& and ;;&).

export HISTFILE="$HOME/.bash_history"
export HISTSIZE=10000
shopt -s histappend

# Versions of the languages chosen for the project (data\projects\<project>\
# versions.txt, "from<TAB>to" lines written by Dev-Kit.exe), as profile.ps1
# does for PowerShell (DECISIONS.md D-80): PATH in POSIX form, the other
# variables as Windows paths. A kit terminal (DEVKIT_TERMINAL, the Terminals
# page) keeps its own.
__devkit_versions() {
    local projects here project file from to fu tu name value entry out
    local nocase=""
    [ -n "$CP_ROOT" ] && [ -n "$CP_DATA" ] && [ -z "$DEVKIT_TERMINAL" ] || return 0
    __devkit_p() {
        if command -v cygpath >/dev/null 2>&1; then
            cygpath -u "$1"
        else
            printf '%s\n' "$1"
        fi
    }
    # Paths compare ignoring case where the file system does (Windows,
    # macOS), exactly on Linux. nocasematch (bash 3.1) covers the case
    # statements below without a process per string; restored at the end.
    shopt -q nocasematch && nocase=1
    case "$OSTYPE" in
        msys* | cygwin* | darwin*) shopt -s nocasematch ;;
    esac
    __devkit_done() {
        [ -n "$nocase" ] || shopt -u nocasematch
        unset -f __devkit_p __devkit_done
    }
    projects="$(__devkit_p "$CP_ROOT")/projects/"
    here="$PWD/"
    case "$here" in "$projects"?*) ;; *) __devkit_done; return 0 ;; esac
    project="${here:${#projects}}"
    project="${project%%/*}"
    file="$(__devkit_p "$CP_DATA")/projects/$project/versions.txt"
    if [ ! -f "$file" ]; then
        __devkit_done
        return 0
    fi
    while IFS=$'\t' read -r from to; do
        to="${to%$'\r'}"
        [ -n "$from" ] && [ -n "$to" ] || continue
        fu="$(__devkit_p "$from")"
        tu="$(__devkit_p "$to")"
        out=""
        local IFS=':'
        for entry in $PATH; do
            case "$entry" in
                "$fu" | "$fu"/*) entry="$tu${entry:${#fu}}" ;;
            esac
            out="${out:+$out:}$entry"
        done
        unset IFS
        PATH="$out"
        for name in JAVA_HOME DOTNET_ROOT CP_PHP PHPRC CP_APACHE CP_CADDY; do
            value="${!name}"
            case "$value" in
                "$from" | "$from"\\* | "$from"/*) export "$name=$to${value:${#from}}" ;;
            esac
        done
    done < "$file"
    __devkit_done
    export PATH
}
__devkit_versions
unset -f __devkit_versions

PS1='\[\e[38;5;75m\]Dev-Kit\[\e[0m\] \[\e[38;5;180m\]\w\[\e[0m\]\$ '

if [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi
