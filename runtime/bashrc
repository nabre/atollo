# Atollo: Git Bash of the kit (written by Atollo.exe to data\kit\bashrc).
# Started as: bash --rcfile <this file> -i. The PC's ~/.bashrc is not read:
# HOME is data\home, so a ~/.bashrc there (yours) is loaded at the end.
# Also read by the system bash of macOS (3.2) and Linux: no bash 4 syntax
# (${var,,}, declare -A, mapfile, ;& and ;;&).

export HISTFILE="$HOME/.bash_history"
export HISTSIZE=10000
shopt -s histappend

# Versions of the languages chosen for the project (data\projects\<project>\
# versions.txt, "from<TAB>to" lines written by Atollo.exe), as profile.ps1
# does for PowerShell (DECISIONS.md D-80): PATH in POSIX form, the other
# variables as Windows paths. A kit terminal (ATOLLO_TERMINAL, the Terminals
# page) keeps its own.
__atollo_versions() {
    local projects here project file from to fu tu name value entry out
    local nocase=""
    [ -n "$CP_ROOT" ] && [ -n "$CP_DATA" ] && [ -z "$ATOLLO_TERMINAL" ] || return 0
    __atollo_p() {
        if command -v cygpath >/dev/null 2>&1; then
            cygpath -u "$1"
        else
            printf '%s\n' "$1"
        fi
    }
    # Paths compare ignoring case where the file system does (Windows,
    # macOS), exactly on Linux. nocasematch (bash 3.1) covers the case
    # statements below without a process per string; restored at the end.
    shopt -q nocasematch && nocase=1
    case "$OSTYPE" in
        msys* | cygwin* | darwin*) shopt -s nocasematch ;;
    esac
    __atollo_done() {
        [ -n "$nocase" ] || shopt -u nocasematch
        unset -f __atollo_p __atollo_done
    }
    projects="$(__atollo_p "$CP_ROOT")/projects/"
    here="$PWD/"
    case "$here" in "$projects"?*) ;; *) __atollo_done; return 0 ;; esac
    project="${here:${#projects}}"
    project="${project%%/*}"
    file="$(__atollo_p "$CP_DATA")/projects/$project/versions.txt"
    if [ ! -f "$file" ]; then
        __atollo_done
        return 0
    fi
    while IFS=$'\t' read -r from to; do
        to="${to%$'\r'}"
        [ -n "$from" ] && [ -n "$to" ] || continue
        fu="$(__atollo_p "$from")"
        tu="$(__atollo_p "$to")"
        out=""
        local IFS=':'
        for entry in $PATH; do
            case "$entry" in
                "$fu" | "$fu"/*) entry="$tu${entry:${#fu}}" ;;
            esac
            out="${out:+$out:}$entry"
        done
        unset IFS
        PATH="$out"
        for name in JAVA_HOME DOTNET_ROOT CP_PHP PHPRC CP_APACHE CP_CADDY; do
            value="${!name}"
            case "$value" in
                "$from" | "$from"\\* | "$from"/*) export "$name=$to${value:${#from}}" ;;
            esac
        done
    done < "$file"
    __atollo_done
    export PATH
}
__atollo_versions
unset -f __atollo_versions

PS1='\[\e[38;5;75m\]Atollo\[\e[0m\] \[\e[38;5;180m\]\w\[\e[0m\]\$ '

# ATOLLO in block letters, in the terminal's own colour; the last O is the
# atoll of the wordmark: emerald on the left, amber and coral on the right
# with the islet, the lagoon inside, the waves under it. Same banner as
# profile.ps1. Bash 3.2 (macOS) included.
__atollo_banner() {
    local e=$'\e' i j c text out
    local A=('  ███  ' ' ██ ██ ' '██   ██' '███████' '██   ██')
    local T=('████████' '   ██   ' '   ██   ' '   ██   ' '   ██   ')
    local O=(' █████ ' '██   ██' '██   ██' '██   ██' ' █████ ')
    local L=('██     ' '██     ' '██     ' '██     ' '███████')
    local atoll=(' sgaao ' 'ssllloo' 'ssllloo' 'gglll o' ' ggloo ' ' mmmmm ')
    printf '\n'
    for i in 0 1 2 3 4 5; do
        if [ "$i" -lt 5 ]; then
            text="${A[i]}  ${T[i]}  ${O[i]}  ${L[i]}  ${L[i]}"
        else
            text=$(printf '%44s' '')
        fi
        out=''
        for ((j = 0; j < 7; j++)); do
            c=${atoll[i]:j:1}
            case "$c" in
                g) out+="$e[38;2;16;185;129m█" ;;
                s) out+="$e[38;2;52;211;153m█" ;;
                a) out+="$e[38;2;251;191;36m█" ;;
                o) out+="$e[38;2;249;115;22m█" ;;
                l) out+="$e[38;2;94;234;212m░" ;;
                m) out+="$e[38;2;209;240;224m~" ;;
                *) out+=' ' ;;
            esac
        done
        printf '  %s[1m%s%s[0m  %s%s[0m\n' "$e" "$text" "$e" "$out" "$e"
    done
    [ -n "$ATOLLO_TERMINAL" ] && printf '  %s[36m%s%s[0m\n' "$e" "$ATOLLO_TERMINAL" "$e"
    printf '\n'
}
[ -z "$ATOLLO_QUIET" ] && __atollo_banner
unset -f __atollo_banner

if [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi
