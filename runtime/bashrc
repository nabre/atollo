# Atollo: Git Bash of the kit (written by Atollo.exe to data\kit\bashrc).
# Started as: bash --rcfile <this file> -i. The PC's ~/.bashrc is not read:
# HOME is data\home, so a ~/.bashrc there (yours) is loaded at the end.

export HISTFILE="$HOME/.bash_history"
export HISTSIZE=10000
shopt -s histappend

# Versions of the languages chosen for the project (data\projects\<project>\
# versions.txt, "from<TAB>to" lines written by Atollo.exe), as profile.ps1
# does for PowerShell (DECISIONS.md D-80): PATH in POSIX form, the other
# variables as Windows paths. A kit terminal (ATOLLO_TERMINAL, the Terminals
# page) keeps its own.
__atollo_versions() {
    local projects here project file from to fu tu name value entry out
    [ -n "$CP_ROOT" ] && [ -n "$CP_DATA" ] && [ -z "$ATOLLO_TERMINAL" ] || return 0
    __atollo_p() {
        if command -v cygpath >/dev/null 2>&1; then
            cygpath -u "$1"
        else
            printf '%s\n' "$1"
        fi
    }
    projects="$(__atollo_p "$CP_ROOT")/projects/"
    here="$PWD/"
    case "${here,,}" in "${projects,,}"?*) ;; *) unset -f __atollo_p; return 0 ;; esac
    project="${here:${#projects}}"
    project="${project%%/*}"
    file="$(__atollo_p "$CP_DATA")/projects/$project/versions.txt"
    if [ ! -f "$file" ]; then
        unset -f __atollo_p
        return 0
    fi
    while IFS=$'\t' read -r from to; do
        to="${to%$'\r'}"
        [ -n "$from" ] && [ -n "$to" ] || continue
        fu="$(__atollo_p "$from")"
        tu="$(__atollo_p "$to")"
        out=""
        local IFS=':'
        for entry in $PATH; do
            case "${entry,,}" in
                "${fu,,}" | "${fu,,}"/*) entry="$tu${entry:${#fu}}" ;;
            esac
            out="${out:+$out:}$entry"
        done
        unset IFS
        PATH="$out"
        for name in JAVA_HOME DOTNET_ROOT CP_PHP PHPRC CP_APACHE CP_NGINX; do
            value="${!name}"
            case "${value,,}" in
                "${from,,}" | "${from,,}"\\* | "${from,,}"/*) export "$name=$to${value:${#from}}" ;;
            esac
        done
    done < "$file"
    unset -f __atollo_p
    export PATH
}
__atollo_versions
unset -f __atollo_versions

PS1='\[\e[38;5;75m\]Atollo\[\e[0m\] \[\e[38;5;180m\]\w\[\e[0m\]\$ '

if [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi
