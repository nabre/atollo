# Build output (also separate target folders, e.g. `target-gate/` for parallel checks)
/target/
/target-*/
/node_modules/
/dist/

# Claude Code: agents' worktrees and personal settings
/.claude/worktrees/
/.claude/settings.local.json

# Created by Atollo.exe when it runs from the repository folder
/data/
/projects/

# Editors
.vscode/
*.swp

# PowerShell/CLR profiling junk
StartupProfileData-NonInteractive
*.prof

# TypeScript incremental build state
*.tsbuildinfo

# Python bytecode
__pycache__/

# Landing page build (site/build.mjs)
/_site/
