{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    // Aliases, also in vite.config.ts: the app (@/), the Guide's content
    // at the root (@guide/, D-164) and the tests' helpers (@test/), in
    // place of deep relative paths.
    "paths": {
      "@/*": ["./src/*"],
      "@guide/*": ["../guide/*"],
      "@test/*": ["../test/ui/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
