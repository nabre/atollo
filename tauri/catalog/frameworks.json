    {
      "id": "tailwind",
      "kind": "addon",
      "slot": "css",
      "name": "Tailwind CSS",
      "desc": "Stili con le classi di utilità di Tailwind CSS 4",
      "home": "https://tailwindcss.com/docs/installation/using-vite",
      "on": {
        "laravel": {
          "note": "Già incluso in Laravel e nei suoi starter kit."
        },
        "symfony": {
          "steps": [
            "composer require symfonycasts/tailwind-bundle:^1.0",
            "php bin/console tailwind:init"
          ],
          "actions": [
            {
              "name": "CSS",
              "command": "php bin/console tailwind:build --watch"
            }
          ]
        },
        "vite": {
          "steps": [
            "npm install -D tailwindcss@4 @tailwindcss/vite@4",
            "$f = 'vite.config.ts'; if (Test-Path $f) { $c = Get-Content $f -Raw; if ($c -match 'plugins:\\s*\\[') { $c = $c -replace 'plugins:\\s*\\[', 'plugins: [tailwindcss(), ' } else { $c = $c -replace 'defineConfig\\((\\s*async\\s*\\(\\)\\s*=>\\s*\\()?\\s*\\{', '$0 plugins: [tailwindcss()],' }; Set-Content $f (\"import tailwindcss from '@tailwindcss/vite'`n\" + $c) } else { Set-Content $f \"import { defineConfig } from 'vite'`nimport tailwindcss from '@tailwindcss/vite'`n`nexport default defineConfig({ plugins: [tailwindcss()] })\" }",
            "foreach ($f in 'src/style.css', 'src/index.css', 'src/app.css') { if (Test-Path $f) { Set-Content $f (\"@import `\"tailwindcss`\";`n\" + (Get-Content $f -Raw)); break } }"
          ]
        },
        "nextjs": {
          "note": "Già incluso dalla creazione di Next.js."
        },
        "electron": {
          "steps": [
            "npm install -D tailwindcss@4 @tailwindcss/vite@4",
            "$f = if (Test-Path electron.vite.config.ts) { 'electron.vite.config.ts' } elseif (Test-Path vite.renderer.config.mts) { 'vite.renderer.config.mts' } else { 'vite.renderer.config.ts' }; if (Test-Path $f) { $c = Get-Content $f -Raw; if ($c -match 'plugins:\\s*\\[') { $c = $c -replace 'plugins:\\s*\\[', 'plugins: [tailwindcss(), ' } else { $c = $c -replace 'defineConfig\\((\\s*async\\s*\\(\\)\\s*=>\\s*\\()?\\s*\\{', '$0 plugins: [tailwindcss()],' }; Set-Content $f (\"import tailwindcss from '@tailwindcss/vite'`n\" + $c) } else { Set-Content $f \"import { defineConfig } from 'vite'`nimport tailwindcss from '@tailwindcss/vite'`n`nexport default defineConfig({ plugins: [tailwindcss()] })\" }",
            "foreach ($f in 'src/index.css', 'src/renderer/src/assets/main.css') { if (Test-Path $f) { Set-Content $f (\"@import `\"tailwindcss`\";`n\" + (Get-Content $f -Raw)); break } }"
          ]
        },
        "tauri": {
          "steps": [
            "npm install -D tailwindcss@4 @tailwindcss/vite@4",
            "$f = 'vite.config.ts'; if (Test-Path $f) { $c = Get-Content $f -Raw; if ($c -match 'plugins:\\s*\\[') { $c = $c -replace 'plugins:\\s*\\[', 'plugins: [tailwindcss(), ' } else { $c = $c -replace 'defineConfig\\((\\s*async\\s*\\(\\)\\s*=>\\s*\\()?\\s*\\{', '$0 plugins: [tailwindcss()],' }; Set-Content $f (\"import tailwindcss from '@tailwindcss/vite'`n\" + $c) } else { Set-Content $f \"import { defineConfig } from 'vite'`nimport tailwindcss from '@tailwindcss/vite'`n`nexport default defineConfig({ plugins: [tailwindcss()] })\" }",
            "foreach ($f in 'src/styles.css', 'src/style.css', 'src/index.css', 'src/app.css', 'src/App.css') { if (Test-Path $f) { Set-Content $f (\"@import `\"tailwindcss`\";`n\" + (Get-Content $f -Raw)); break } }"
          ]
        }
      }
    },
    {
      "id": "bootstrap",
      "kind": "addon",
      "slot": "css",
      "name": "Bootstrap",
      "desc": "Componenti e griglia di Bootstrap 5",
      "home": "https://getbootstrap.com/docs/5.3/getting-started/vite/",
      "on": {
        "laravel": {
          "steps": [
            "npm install bootstrap@5",
            "Set-Content resources/css/app.css (\"@import 'bootstrap/dist/css/bootstrap.min.css';`n\" + (Get-Content resources/css/app.css -Raw))"
          ],
          "note": "Tailwind CSS resta: fa parte di Laravel."
        },
        "symfony": {
          "steps": [
            "php bin/console importmap:require bootstrap bootstrap/dist/css/bootstrap.min.css",
            "Set-Content assets/app.js (\"import 'bootstrap/dist/css/bootstrap.min.css';`n\" + (Get-Content assets/app.js -Raw))"
          ]
        },
        "vite": {
          "steps": [
            "npm install bootstrap@5",
            "foreach ($f in 'src/main.ts', 'src/main.tsx', 'src/main.js', 'src/renderer.ts', 'src/renderer/src/main.ts', 'src/renderer/src/main.tsx') { if (Test-Path $f) { Set-Content $f (\"import 'bootstrap/dist/css/bootstrap.min.css';`n\" + (Get-Content $f -Raw)); break } }"
          ]
        },
        "nextjs": {
          "steps": [
            "npm install bootstrap@5",
            "foreach ($f in 'src/app/layout.tsx', 'app/layout.tsx') { if (Test-Path $f) { Set-Content $f (\"import 'bootstrap/dist/css/bootstrap.min.css';`n\" + (Get-Content $f -Raw)); break } }"
          ],
          "note": "Tailwind CSS resta: fa parte della creazione di Next.js."
        },
        "electron": {
          "steps": [
            "npm install bootstrap@5",
            "foreach ($f in 'src/main.ts', 'src/main.tsx', 'src/main.js', 'src/renderer.ts', 'src/renderer/src/main.ts', 'src/renderer/src/main.tsx') { if (Test-Path $f) { Set-Content $f (\"import 'bootstrap/dist/css/bootstrap.min.css';`n\" + (Get-Content $f -Raw)); break } }"
          ]
        },
        "tauri": {
          "steps": [
            "npm install bootstrap@5",
            "foreach ($f in 'src/main.ts', 'src/main.tsx', 'src/main.js', 'src/renderer.ts', 'src/renderer/src/main.ts', 'src/renderer/src/main.tsx') { if (Test-Path $f) { Set-Content $f (\"import 'bootstrap/dist/css/bootstrap.min.css';`n\" + (Get-Content $f -Raw)); break } }"
          ]
        }
      }
    },
    {
      "id": "bulma",
      "kind": "addon",
      "slot": "css",
      "name": "Bulma",
      "desc": "Stili di Bulma, solo CSS senza JavaScript",
      "home": "https://bulma.io/documentation/start/installation/",
      "on": {
        "laravel": {
          "steps": [
            "npm install bulma@1",
            "Set-Content resources/css/app.css (\"@import 'bulma/css/bulma.min.css';`n\" + (Get-Content resources/css/app.css -Raw))"
          ],
          "note": "Tailwind CSS resta: fa parte di Laravel."
        },
        "symfony": {
          "steps": [
            "php bin/console importmap:require bulma/css/bulma.min.css",
            "Set-Content assets/app.js (\"import 'bulma/css/bulma.min.css';`n\" + (Get-Content assets/app.js -Raw))"
          ]
        },
        "vite": {
          "steps": [
            "npm install bulma@1",
            "foreach ($f in 'src/main.ts', 'src/main.tsx', 'src/main.js', 'src/renderer.ts', 'src/renderer/src/main.ts', 'src/renderer/src/main.tsx') { if (Test-Path $f) { Set-Content $f (\"import 'bulma/css/bulma.min.css';`n\" + (Get-Content $f -Raw)); break } }"
          ]
        },
        "nextjs": {
          "steps": [
            "npm install bulma@1",
            "foreach ($f in 'src/app/layout.tsx', 'app/layout.tsx') { if (Test-Path $f) { Set-Content $f (\"import 'bulma/css/bulma.min.css';`n\" + (Get-Content $f -Raw)); break } }"
          ],
          "note": "Tailwind CSS resta: fa parte della creazione di Next.js."
        },
        "electron": {
          "steps": [
            "npm install bulma@1",
            "foreach ($f in 'src/main.ts', 'src/main.tsx', 'src/main.js', 'src/renderer.ts', 'src/renderer/src/main.ts', 'src/renderer/src/main.tsx') { if (Test-Path $f) { Set-Content $f (\"import 'bulma/css/bulma.min.css';`n\" + (Get-Content $f -Raw)); break } }"
          ]
        },
        "tauri": {
          "steps": [
            "npm install bulma@1",
            "foreach ($f in 'src/main.ts', 'src/main.tsx', 'src/main.js', 'src/renderer.ts', 'src/renderer/src/main.ts', 'src/renderer/src/main.tsx') { if (Test-Path $f) { Set-Content $f (\"import 'bulma/css/bulma.min.css';`n\" + (Get-Content $f -Raw)); break } }"
          ]
        }
      }
    },
    {
      "id": "sqlite",
      "kind": "addon",
      "slot": "database",
      "name": "SQLite",
      "desc": "Database in un file del progetto, senza server",
      "home": "https://laravel.com/docs/13.x/database#sqlite-configuration",
      "on": {
        "laravel": {
          "needs": [
            "sqlite"
          ],
          "note": "Predefinito di Laravel: database/database.sqlite c'è già."
        }
      }
    },
    {
      "id": "mysql",
      "kind": "addon",
      "slot": "database",
      "name": "MySQL (MariaDB)",
      "desc": "Il server MariaDB del kit, compatibile con MySQL",
      "home": "https://laravel.com/docs/13.x/database#configuration",
      "on": {
        "laravel": {
          "database": "mariadb",
          "steps": [
            "php artisan migrate --force"
          ],
          "note": "Il kit crea il database del progetto e scrive la connessione nel file .env."
        }
      }
    },
    {
      "id": "mongodb",
      "kind": "addon",
      "slot": "database",
      "name": "MongoDB",
      "desc": "Il server MongoDB del kit, con il pacchetto ufficiale per Laravel",
      "home": "https://www.mongodb.com/docs/drivers/php/laravel-mongodb/current/quick-start/",
      "on": {
        "laravel": {
          "database": "mongodb",
          "steps": [
            "composer require mongodb/laravel-mongodb:^5.11",
            "$c = Get-Content config/database.php -Raw; Set-Content config/database.php ($c -replace \"'connections' => \\[\", \"'connections' => [`n`n        'mongodb' => ['driver' => 'mongodb', 'dsn' => env('MONGODB_URI'), 'database' => env('DB_DATABASE')],`n\")"
          ],
          "note": "Serve l'estensione mongodb di PHP, che il kit non installa ancora: senza, il comando composer si ferma."
        }
      }
    },
    {
      "id": "nativephp",
      "kind": "addon",
      "slot": "desktop",
      "name": "Electron (NativePHP)",
      "desc": "La stessa app Laravel anche come app desktop, con Electron",
      "home": "https://nativephp.com/docs/desktop/2/getting-started/installation",
      "on": {
        "laravel": {
          "env": [
            {
              "key": "NATIVEPHP_APP_ID",
              "value": "{package}"
            }
          ],
          "steps": [
            "composer require nativephp/desktop:^2.3",
            "php artisan native:install --no-interaction"
          ],
          "actions": [
            {
              "name": "App desktop",
              "command": "php artisan native:run"
            },
            {
              "name": "Pacchetto",
              "command": "php artisan native:build win"
            }
          ]
        }
      }
    },
    {
      "id": "nativephp-mobile",
      "kind": "addon",
      "slot": "mobile",
      "name": "Android (NativePHP Mobile)",
      "desc": "La stessa app Laravel anche come app Android",
      "home": "https://nativephp.com/docs/mobile/3/getting-started/installation",
      "on": {
        "laravel": {
          "needs": [
            "java",
            "android"
          ],
          "env": [
            {
              "key": "NATIVEPHP_APP_ID",
              "value": "{package}"
            }
          ],
          "steps": [
            "composer require nativephp/mobile:^4.6",
            "php artisan native:install --no-interaction"
          ],
          "actions": [
            {
              "name": "Android",
              "command": "php artisan native:run android"
            }
          ]
        }
      }
    },
    {
      "id": "capacitor",
      "kind": "addon",
      "slot": "mobile",
      "name": "Android",
      "desc": "La stessa app anche come app Android: Capacitor con Vite, Tauri mobile con Tauri",
      "home": "https://capacitorjs.com/docs/getting-started",
      "on": {
        "vite": {
          "needs": [
            "java",
            "android"
          ],
          "steps": [
            "npm install @capacitor/core@8 @capacitor/android@8",
            "npm install -D @capacitor/cli@8",
            "npx cap init {name} {package} --web-dir dist",
            "npm run build",
            "npx cap add android"
          ],
          "actions": [
            {
              "name": "Android",
              "command": "npx cap run android"
            },
            {
              "name": "Sincronizza Android",
              "command": "npm run build && npx cap sync android"
            }
          ],
          "note": "Con Capacitor. Prova l'app su un telefono collegato con il debug USB."
        },
        "tauri": {
          "needs": [
            "java",
            "android"
          ],
          "steps": [
            "sdkmanager --install \"ndk;30.0.16248370\"",
            "rustup target add aarch64-linux-android armv7-linux-androideabi i686-linux-android x86_64-linux-android",
            "npm run tauri android init -- --ci"
          ],
          "actions": [
            {
              "name": "Android",
              "command": "npm run tauri android dev"
            },
            {
              "name": "APK",
              "command": "npm run tauri android build -- --apk"
            }
          ],
          "note": "Scarica anche l'NDK di Android (circa 2 GB) e i target Rust per Android."
        }
      }
    },
    {
      "id": "pest",
      "kind": "addon",
      "slot": "tests",
      "name": "Pest",
      "desc": "Prove automatiche con Pest al posto di PHPUnit",
      "home": "https://pestphp.com/docs/installation",
      "on": {
        "laravel": {
          "steps": [
            "composer remove phpunit/phpunit --dev --no-update",
            "composer require pestphp/pest:^5.3 pestphp/pest-plugin-laravel --dev --with-all-dependencies",
            "vendor\\bin\\pest --init"
          ],
          "actions": [
            {
              "name": "Prove",
              "command": "vendor\\bin\\pest"
            }
          ]
        }
      }
    },
    {
      "id": "filament",
      "kind": "addon",
      "slot": "admin",
      "name": "Filament",
      "desc": "Pannello di amministrazione per Laravel",
      "home": "https://filamentphp.com/docs/5.x/introduction/installation",
      "on": {
        "laravel": {
          "steps": [
            "composer require filament/filament:^5.10 --with-all-dependencies",
            "php artisan filament:install --panels --no-interaction"
          ]
        }
      }
    },
    {
      "id": "vitest",
      "kind": "addon",
      "slot": "tests",
      "name": "Vitest",
      "desc": "Prove automatiche per il codice TypeScript",
      "home": "https://vitest.dev/guide/",
      "on": {
        "vite": {
          "steps": [
            "npm install -D vitest@5",
            "npm pkg set scripts.test=vitest"
          ],
          "actions": [
            {
              "name": "Prove",
              "command": "npm test"
            }
          ]
        },
        "tauri": {
          "steps": [
            "npm install -D vitest@5",
            "npm pkg set scripts.test=vitest"
          ],
          "actions": [
            {
              "name": "Prove",
              "command": "npm test"
            }
          ]
        }
      }
    },
    {
      "id": "prettier",
      "kind": "addon",
      "slot": "format",
      "name": "Prettier",
      "desc": "Formattazione automatica del codice",
      "home": "https://prettier.io/docs/install",
      "on": {
        "vite": {
          "steps": [
            "npm install -D prettier@3",
            "npm pkg set \"scripts.format=prettier --write .\""
          ]
        },
        "nextjs": {
          "steps": [
            "npm install -D prettier@3",
            "npm pkg set \"scripts.format=prettier --write .\""
          ]
        },
        "electron": {
          "steps": [
            "npm install -D prettier@3",
            "npm pkg set \"scripts.format=prettier --write .\""
          ]
        },
        "tauri": {
          "steps": [
            "npm install -D prettier@3",
            "npm pkg set \"scripts.format=prettier --write .\""
          ]
        }
      }
    }
  ]
}
