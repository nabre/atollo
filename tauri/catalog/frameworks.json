    {
      "id": "android",
      "kind": "base",
      "name": "Android",
      "desc": "App Android in Kotlin con Jetpack Compose (modello ufficiale di Google)",
      "home": "https://github.com/android/architecture-templates",
      "needs": [
        "git",
        "java",
        "android"
      ],
      "create": [
        "git clone --depth 1 --branch base https://github.com/android/architecture-templates.git {name}"
      ],
      "steps": [
        "Remove-Item -Recurse -Force .git",
        "bash customizer.sh {package} Item {name}",
        "git init"
      ],
      "actions": [
        {
          "name": "Build",
          "command": ".\\gradlew.bat assembleDebug"
        }
      ]
    },
    {
      "id": "wordpress",
      "kind": "base",
      "name": "WordPress",
      "desc": "Sito WordPress con Composer (Bedrock), plugin e temi come pacchetti",
      "home": "https://roots.io/bedrock/docs/installation/",
      "needs": [
        "php"
      ],
      "create": [
        "composer create-project roots/bedrock:^1.31 {name}"
      ],
      "steps": [
        "$c = Get-Content .env -Raw; foreach ($k in 'AUTH_KEY', 'SECURE_AUTH_KEY', 'LOGGED_IN_KEY', 'NONCE_KEY', 'AUTH_SALT', 'SECURE_AUTH_SALT', 'LOGGED_IN_SALT', 'NONCE_SALT') { $v = [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)); $c = $c -replace \"(?m)^$k=[^\\r\\n]*\", \"$k='$v'\" }; Set-Content .env $c -NoNewline",
        "Add-Content config/environments/development.php \"`nConfig::define('WP_HOME', 'http://' . (`$_SERVER['HTTP_HOST'] ?? 'localhost'));`nConfig::define('WP_SITEURL', Config::get('WP_HOME') . '/wp');`nConfig::define('WP_CONTENT_URL', Config::get('WP_HOME') . Config::get('CONTENT_DIR'));\"",
        "composer require wp-cli/wp-cli-bundle:^2.12 --dev",
        "vendor\\bin\\wp core install --url=http://localhost --title={name} --admin_user=$env:ADMIN_USER --admin_password=$env:ADMIN_PASSWORD --admin_email=$env:ADMIN_EMAIL --skip-email"
      ],
      "actions": [
        {
          "name": "Avvia",
          "command": "php -S 127.0.0.1:8000 -t web"
        }
      ],
      "env": [
        {
          "key": "WP_HOME",
          "value": "http://localhost"
        },
        {
          "key": "ADMIN_USER",
          "value": "admin"
        },
        {
          "key": "ADMIN_PASSWORD",
          "value": "{password}"
        },
        {
          "key": "ADMIN_EMAIL",
          "value": "admin@example.com"
        }
      ],
      "database": "mariadb",
      "note": "Pannello in /wp/wp-admin, con ADMIN_USER e ADMIN_PASSWORD del file .env. Il sito risponde all'indirizzo con cui lo apri, su qualsiasi porta."
    },
    {
      "id": "typo3",
      "kind": "base",
      "name": "TYPO3",
      "desc": "CMS TYPO3 per siti grandi e multilingua",
      "home": "https://docs.typo3.org/m/typo3/tutorial-getting-started/main/en-us/Installation/Install.html",
      "needs": [
        "php"
      ],
      "create": [
        "composer create-project typo3/cms-base-distribution:^14.3 {name}"
      ],
      "steps": [
        "vendor\\bin\\typo3 setup -n --driver=mysqli --host=$env:DEVKIT_DB_HOST --port=$env:DEVKIT_DB_PORT --dbname=$env:DEVKIT_DB_NAME --username=$env:DEVKIT_DB_USER --password=$env:DEVKIT_DB_PASSWORD --admin-username=$env:ADMIN_USER --admin-user-password=$env:ADMIN_PASSWORD --admin-email=$env:ADMIN_EMAIL --project-name={name} --server-type=other --create-site=http://localhost/",
        "Get-ChildItem config/sites -Recurse -Filter config.yaml | ForEach-Object { $c = Get-Content $_.FullName -Raw; Set-Content $_.FullName ($c -replace '(?m)^base: [^\\r\\n]*', 'base: /') -NoNewline }",
        "$f = 'config/system/additional.php'; if (-not (Test-Path $f)) { New-Item -ItemType Directory -Force config/system | Out-Null; Set-Content $f '<?php' }; Add-Content $f \"`$GLOBALS['TYPO3_CONF_VARS']['SYS']['trustedHostsPattern'] = '(localhost|127\\.0\\.0\\.1)(:\\d+)?';\""
      ],
      "actions": [
        {
          "name": "Avvia",
          "command": "php -S 127.0.0.1:8000 -t public"
        }
      ],
      "env": [
        {
          "key": "ADMIN_USER",
          "value": "admin"
        },
        {
          "key": "ADMIN_PASSWORD",
          "value": "{password}"
        },
        {
          "key": "ADMIN_EMAIL",
          "value": "admin@example.com"
        }
      ],
      "database": "mariadb",
      "note": "Pannello in /typo3, con ADMIN_USER e ADMIN_PASSWORD del file .env. Una password scritta a mano vuole maiuscole, minuscole, cifre e un segno."
    },
    {
      "id": "drupal",
      "kind": "base",
      "name": "Drupal",
      "desc": "CMS Drupal con Drush, per siti e portali strutturati",
      "home": "https://www.drupal.org/docs/getting-started/installing-drupal",
      "needs": [
        "php"
      ],
      "create": [
        "composer create-project drupal/recommended-project:^11.4 {name}"
      ],
      "steps": [
        "composer require drush/drush:^13.8",
        "vendor\\bin\\drush site:install standard --yes --db-url=$env:DEVKIT_DB_URL --site-name={name} --site-mail=$env:ADMIN_EMAIL --account-name=$env:ADMIN_USER --account-pass=$env:ADMIN_PASSWORD --account-mail=$env:ADMIN_EMAIL"
      ],
      "actions": [
        {
          "name": "Avvia",
          "command": "vendor\\bin\\drush runserver 127.0.0.1:8000"
        },
        {
          "name": "Svuota cache",
          "command": "vendor\\bin\\drush cache:rebuild"
        }
      ],
      "env": [
        {
          "key": "ADMIN_USER",
          "value": "admin"
        },
        {
          "key": "ADMIN_PASSWORD",
          "value": "{password}"
        },
        {
          "key": "ADMIN_EMAIL",
          "value": "admin@example.com"
        }
      ],
      "database": "mariadb",
      "note": "Accesso in /user/login, con ADMIN_USER e ADMIN_PASSWORD del file .env."
    },
    {
