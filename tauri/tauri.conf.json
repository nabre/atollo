{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atollo",
  "mainBinaryName": "Atollo",
  "identifier": "io.github.nabre.atollo",
  "build": {
    "beforeDevCommand": {
      "script": "node ../scripts/dev-ui.mjs",
      "cwd": "../ui"
    },
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'",
      "capabilities": [
        "main",
        "terminal"
      ],
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "appimage"
    ],
    "publisher": "nabre",
    "copyright": "Copyright (c) nabre",
    "category": "DeveloperTool",
    "shortDescription": "Atollo — Universal Portable Dev & AI Workspace",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
