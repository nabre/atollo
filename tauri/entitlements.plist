<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements of Atollo.app under the hardened runtime (WP-5.1, T5.1.4;
  bundle.macOS.entitlements in tauri.conf.json). They only take effect
  with `codesign -o runtime`, which the Tauri bundler applies with
  hardenedRuntime true, ad hoc signature included. Not sandboxed: the app
  writes the kit next to the bundle and starts the programs it downloads.
-->
<plist version="1.0">
<dict>
  <!--
    allow-jit: lets the app's own process map memory with MAP_JIT. WKWebView
    runs the page's JavaScript in WebKit's WebContent process, which carries
    Apple's entitlements, so today the app process itself does not need it;
    it is kept so that WebView features that compile in-process (direct use
    of JavaScriptCore, WebAssembly in a future WebKit) do not crash under the
    hardened runtime. To verify on the notarized build of WP-5.2: drop it if
    the app and the editor work without it.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!--
    disable-library-validation: under the hardened runtime a process loads
    only libraries signed by Apple or by its own Team ID. An ad hoc signature
    (Q-2: no Developer ID) has no Team ID, so library validation would refuse
    any library that is not Apple's, a framework later embedded in the bundle
    included. Programs the kit downloads run in their own processes and are
    not affected either way.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
